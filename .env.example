# MLflow tracking (optional — training works locally without it)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=mental_health_classification

# MinIO / S3 credentials for MLflow artifacts and DVC
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1

# Synthetic API / local LLM runtime
SYNTHETIC_LLM_BACKEND=mock
SYNTHETIC_LLM_MODEL_PATH=drift/models/Qwen2.5-3B-Instruct-GGUF/qwen2.5-3b-instruct-q4_k_m.gguf
SYNTHETIC_API_HOST=0.0.0.0
SYNTHETIC_API_PORT=8001
SYNTHETIC_LLM_TEMPERATURE=0.3
SYNTHETIC_LLM_MAX_RETRIES=2
SYNTHETIC_LLM_MAX_TOKENS=256
SYNTHETIC_LLM_CONTEXT_WINDOW=4096
SYNTHETIC_LLM_GPU_LAYERS=-1
