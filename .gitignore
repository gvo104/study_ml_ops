# Python кэш и байткод (уже есть выше, но на всякий случай)
*.pyc
__pycache__/
.ipynb_checkpoints/

# Исключаем данные из Git (DVC будет управлять ими)
data/processed/*.csv
data/raw/*.csv
data/interim/*.csv
data/external/*.csv

# НО! DVC-метафайлы (.dvc) должны быть в Git
!data/**/*.dvc
!data/**/.gitignore

# Модели и бинарные артефакты (теперь MLflow управляет ими, не Git)
models/xgboost/*.pkl
models/xgboost/*.json
!models/xgboost/.gitkeep
!models/.gitkeep

# MLflow
mlruns/
mlflow.db

# MinIO данные (в Docker volume)
minio_data/

# DVC служебное
.dvc/tmp
.dvc/cache

# Дополнительно — исключаем конкретные файлы и папки, которые не нужны в Git
*.pkl
*.json
!data/**/*.dvc        # кроме DVC-файлов
!data/**/*.json       # кроме JSON в данных (если DVC будет использовать)
!configs/**/*.json
*.db
*.log
study_ml_ops/models/
study_ml_ops/reports/figures/
PROJECT_CONTEXT.md
minio/
mlflow/
metadata/
restore_minio_mlflow_state.sh
